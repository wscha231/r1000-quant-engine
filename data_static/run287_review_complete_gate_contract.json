{
  "schema_version": "run287-review-complete-gate-contract-v3",
  "protected_branch": "master",
  "required_status_checks": [
    "validate",
    "portfolio_guard",
    "review_complete"
  ],
  "strict_status_checks": true,
  "risk_tiers": {
    "R0": {
      "description": "documentation/general-test-only non-mutating changes",
      "independent_review_required": false,
      "maintainer_attestation_required": true
    },
    "R1": {
      "description": "data/PIT/non-executing research assets and isolated research_only code",
      "independent_review_required": false,
      "maintainer_attestation_required": true
    },
    "R2": {
      "description": "all workflows, tools/scripts/executables, portfolio/target/risk/execution policy",
      "independent_review_required": true,
      "maintainer_attestation_required": true
    },
    "R3": {
      "description": "governance/safety, broker/live/order/ledger/accepted-state/secrets/schedulers/mutation authority",
      "independent_review_required": true,
      "maintainer_attestation_required": true
    }
  },
  "classification": {
    "source": "complete PR changed-file inventory plus both added and removed patch lines",
    "self_declared_pr_label_can_downgrade": false,
    "unknown_executable_default": "R2",
    "workflow_default": "R2",
    "workflow_patch_unavailable_default": "R3",
    "executable_patch_unavailable_default": "R3",
    "governance_gate_changes_always": "R3",
    "all_scoped_agents_md_changes": "R3",
    "renames_classify_old_and_new_paths": true,
    "inventory_count_must_match_pr_changed_files": true
  },
  "canonical_required_workflows": {
    "validate": ".github/workflows/pr_validation.yml",
    "portfolio_guard": ".github/workflows/portfolio_system_guard.yml"
  },
  "accepted_codex_reviewers": [
    "chatgpt-codex-connector",
    "chatgpt-codex-connector[bot]"
  ],
  "accepted_evidence": [
    "MAINTAINER_ATTESTED_LOW_RISK",
    "ATTESTED_EXACT_HEAD_CODEX_REVIEW",
    "MAINTAINER_BOUND_CODEX_CLEAN_REACTION"
  ],
  "exact_head_review_policy": {
    "R0": "maintainer exact-head attestation is sufficient after canonical checks and thread gate",
    "R1": "maintainer exact-head attestation is sufficient after canonical checks and thread gate",
    "R2": "Codex exact-head review/reaction plus maintainer attestation required",
    "R3": "Codex exact-head review/reaction plus maintainer attestation required"
  },
  "trusted_head_observation_check": "review_head_observed",
  "review_evidence_must_postdate_head_observation": true,
  "maintainer_attestation_required": true,
  "maintainer_attestation_permissions": [
    "admin",
    "maintain",
    "write"
  ],
  "maintainer_attestation_exact_sha_required": true,
  "clean_reaction_manual_refresh_command": "/review-complete <40-char-head-sha>",
  "required_conversation_resolution": true,
  "trusted_current_head_changes_requested_blocks": true,
  "automatic_merge_allowed": false,
  "admin_merge_bypass_allowed": false,
  "fullrun_required": false,
  "production_activation_allowed": false,
  "live_trading_enabled": false,
  "r3_operational_activation_requires_separate_explicit_user_approval": true,
  "required_code_checks_verified_by_canonical_workflow_path": true,
  "unresolved_review_threads_verified_inside_review_gate": true
}
