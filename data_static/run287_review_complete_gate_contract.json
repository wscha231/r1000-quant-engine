{
  "schema_version": "run287-review-complete-gate-contract-v1",
  "protected_branch": "master",
  "required_status_checks": [
    "validate",
    "portfolio_guard",
    "review_complete"
  ],
  "strict_status_checks": true,
  "accepted_reviewers": [
    "chatgpt-codex-connector",
    "chatgpt-codex-connector[bot]"
  ],
  "accepted_evidence": [
    "EXACT_HEAD_REVIEW",
    "FRESH_CLEAN_REACTION"
  ],
  "exact_head_review_required_when_review_exists": true,
  "clean_reaction_must_postdate_head_commit": true,
  "clean_reaction_manual_refresh_command": "/review-complete",
  "required_conversation_resolution": true,
  "dismiss_stale_reviews": true,
  "required_approving_review_count": 0,
  "enforce_admins": true,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "required_linear_history": false,
  "automatic_merge_allowed": false,
  "admin_merge_bypass_allowed": false,
  "fullrun_required": false,
  "production_activation_allowed": false,
  "live_trading_enabled": false
}
