{
  "schema_version": "global-book-contract-v1",
  "research_only": true,
  "truth_priority": [
    "ACTUAL_BROKER_BOOK",
    "APPROVED_TARGET",
    "VERIFIED_PAPER_BOOK",
    "SIMULATED_EXECUTION",
    "RESEARCH_SIGNAL"
  ],
  "books": {
    "RESEARCH_SIGNAL": {
      "may_write_orders": false,
      "economic_authority": "NONE"
    },
    "CANDIDATE_UNIVERSE": {
      "may_write_orders": false,
      "economic_authority": "NONE"
    },
    "TARGET_PROPOSAL": {
      "may_write_orders": false,
      "economic_authority": "PROPOSAL_ONLY"
    },
    "SIMULATED_EXECUTION": {
      "may_write_orders": false,
      "economic_authority": "SIMULATION_ONLY"
    },
    "PAPER_BOOK": {
      "may_write_orders": false,
      "economic_authority": "PAPER_ONLY"
    },
    "ACTUAL_BROKER_BOOK": {
      "may_write_orders": false,
      "economic_authority": "OBSERVED_TRUTH_ONLY"
    }
  },
  "required_identity": [
    "security_id",
    "issuer_id",
    "ticker",
    "instrument",
    "market",
    "country",
    "currency",
    "lifecycle_state"
  ],
  "portfolio_actions": [
    "NEW_ENTRY",
    "ADD",
    "HOLD",
    "TRIM",
    "REPLACE",
    "EXIT",
    "NO_TRADE",
    "FORCED_EXIT"
  ],
  "rules": {
    "book_namespace_mixing_allowed": false,
    "etf_direct_overlap_must_aggregate": true,
    "short_term_rs_only_exit_allowed": false,
    "average_down_to_lower_cost_allowed": false
  }
}
