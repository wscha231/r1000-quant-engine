{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent",
    "assigned_by",
    "return_to",
    "status",
    "reasons",
    "inputs",
    "outputs",
    "authority",
    "mode",
    "dependencies",
    "dependency_outputs",
    "identity",
    "task_key"
  ],
  "properties": {
    "schema_version": {
      "const": "task-packet-v2"
    },
    "agent": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "A4",
        "A5",
        "A6",
        "A7",
        "A8"
      ]
    },
    "assigned_by": {
      "const": "A0"
    },
    "return_to": {
      "const": "A0"
    },
    "status": {
      "enum": [
        "READY",
        "BLOCKED",
        "SKIP_UNCHANGED"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/artifact"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "execute",
        "target",
        "broker",
        "scheduler",
        "promotion",
        "peer_dispatch"
      ],
      "properties": {
        "research_only": {
          "const": true
        },
        "execute": {
          "const": false
        },
        "target": {
          "const": false
        },
        "broker": {
          "const": false
        },
        "scheduler": {
          "const": false
        },
        "promotion": {
          "const": false
        },
        "peer_dispatch": {
          "const": false
        }
      }
    },
    "mode": {
      "enum": [
        "PROPOSAL_ONLY",
        "READ_ONLY"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "enum": [
          "A1",
          "A2",
          "A3",
          "A4",
          "A5",
          "A6",
          "A7",
          "A8"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "dependency_outputs": {
      "type": "object"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_hash",
        "code_sha",
        "config_hash",
        "model",
        "parameters"
      ],
      "properties": {
        "input_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "task_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Non-executable A0 specialist task proposal",
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "observed_at",
        "available_at",
        "collected_at",
        "expires_at",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "const": "VERIFIED"
        }
      }
    }
  }
}
