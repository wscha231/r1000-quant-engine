{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unified candidate data queue V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "research_only",
    "direct_score_contribution",
    "authority",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "candidate-data-queue-v1"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "research_only": {
      "const": true
    },
    "direct_score_contribution": {
      "const": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "identity_kind",
          "security_id",
          "issuer_id",
          "ticker",
          "state",
          "membership_reasons",
          "required_channels",
          "channel_status",
          "next_action",
          "first_seen_at",
          "last_checked_at"
        ],
        "properties": {
          "security_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "issuer_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "ticker": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "state": {
            "enum": [
              "UNIVERSE",
              "DISCOVERED",
              "DATA_PENDING",
              "VERIFIED",
              "TRACK",
              "REJECTED",
              "STALE",
              "QUARANTINED",
              "RISK_WATCH"
            ]
          },
          "membership_reasons": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 1
          },
          "required_channels": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "price",
                "corporate_action",
                "fundamentals",
                "earnings_actual",
                "guidance",
                "consensus_estimates",
                "sec_material_filings",
                "form4",
                "13f",
                "industry_theme",
                "news_ir",
                "macro_exposure",
                "commodity_exposure",
                "thesis",
                "valuation",
                "expected_return"
              ]
            },
            "minItems": 1
          },
          "channel_status": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "price",
                "corporate_action",
                "fundamentals",
                "earnings_actual",
                "guidance",
                "consensus_estimates",
                "sec_material_filings",
                "form4",
                "13f",
                "industry_theme",
                "news_ir",
                "macro_exposure",
                "commodity_exposure",
                "thesis",
                "valuation",
                "expected_return"
              ]
            },
            "additionalProperties": {
              "enum": [
                "CONSUMER_RECEIPT_MISSING",
                "VERIFIED",
                "DATA_PENDING",
                "PROVIDER_UNCOVERED",
                "FETCH_FAILED",
                "STALE",
                "QUARANTINED",
                "NOT_APPLICABLE"
              ]
            }
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "identity_kind": {
            "enum": [
              "LISTED_SECURITY",
              "NON_ISSUER_ASSET"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "identity_kind": {
                  "const": "LISTED_SECURITY"
                }
              },
              "required": [
                "identity_kind"
              ]
            },
            "then": {
              "properties": {
                "security_id": {
                  "type": "string",
                  "minLength": 1
                },
                "issuer_id": {
                  "type": "string",
                  "minLength": 1
                },
                "ticker": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "identity_kind": {
                  "const": "NON_ISSUER_ASSET"
                }
              },
              "required": [
                "identity_kind"
              ]
            },
            "then": {
              "properties": {
                "security_id": {
                  "const": null
                },
                "issuer_id": {
                  "const": null
                },
                "ticker": {
                  "const": null
                }
              }
            }
          }
        ]
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "er",
        "target",
        "portfolio",
        "broker",
        "orders",
        "promotion"
      ],
      "properties": {
        "selector": {
          "const": false
        },
        "er": {
          "const": false
        },
        "target": {
          "const": false
        },
        "portfolio": {
          "const": false
        },
        "broker": {
          "const": false
        },
        "orders": {
          "const": false
        },
        "promotion": {
          "const": false
        }
      }
    }
  }
}
