{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "admission": {
          "const": false,
          "type": "boolean"
        },
        "broker": {
          "const": false,
          "type": "boolean"
        },
        "canonical_write": {
          "const": false,
          "type": "boolean"
        },
        "dispatch": {
          "const": false,
          "type": "boolean"
        },
        "er": {
          "const": false,
          "type": "boolean"
        },
        "execute": {
          "const": false,
          "type": "boolean"
        },
        "learning": {
          "const": false,
          "type": "boolean"
        },
        "ledger": {
          "const": false,
          "type": "boolean"
        },
        "orders": {
          "const": false,
          "type": "boolean"
        },
        "paper": {
          "const": false,
          "type": "boolean"
        },
        "portfolio": {
          "const": false,
          "type": "boolean"
        },
        "production": {
          "const": false,
          "type": "boolean"
        },
        "promotion": {
          "const": false,
          "type": "boolean"
        },
        "selector": {
          "const": false,
          "type": "boolean"
        },
        "target": {
          "const": false,
          "type": "boolean"
        }
      },
      "required": [
        "selector",
        "er",
        "target",
        "portfolio",
        "paper",
        "broker",
        "orders",
        "promotion",
        "execute",
        "production",
        "dispatch",
        "admission",
        "ledger",
        "canonical_write",
        "learning"
      ],
      "type": "object"
    },
    "events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "affected_pillars": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "assessment_eligible": {
            "type": "boolean"
          },
          "asset_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "authority": {
            "additionalProperties": false,
            "properties": {
              "admission": {
                "const": false,
                "type": "boolean"
              },
              "broker": {
                "const": false,
                "type": "boolean"
              },
              "canonical_write": {
                "const": false,
                "type": "boolean"
              },
              "dispatch": {
                "const": false,
                "type": "boolean"
              },
              "er": {
                "const": false,
                "type": "boolean"
              },
              "execute": {
                "const": false,
                "type": "boolean"
              },
              "learning": {
                "const": false,
                "type": "boolean"
              },
              "ledger": {
                "const": false,
                "type": "boolean"
              },
              "orders": {
                "const": false,
                "type": "boolean"
              },
              "paper": {
                "const": false,
                "type": "boolean"
              },
              "portfolio": {
                "const": false,
                "type": "boolean"
              },
              "production": {
                "const": false,
                "type": "boolean"
              },
              "promotion": {
                "const": false,
                "type": "boolean"
              },
              "selector": {
                "const": false,
                "type": "boolean"
              },
              "target": {
                "const": false,
                "type": "boolean"
              }
            },
            "required": [
              "selector",
              "er",
              "target",
              "portfolio",
              "paper",
              "broker",
              "orders",
              "promotion",
              "execute",
              "production",
              "dispatch",
              "admission",
              "ledger",
              "canonical_write",
              "learning"
            ],
            "type": "object"
          },
          "available_at": {
            "format": "date-time",
            "maxLength": 40,
            "type": "string"
          },
          "claim": {
            "maxLength": 1800,
            "minLength": 1,
            "type": "string"
          },
          "cohort_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
            "type": "string"
          },
          "collected_at": {
            "format": "date-time",
            "maxLength": 40,
            "type": "string"
          },
          "event_family": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
            "type": "string"
          },
          "event_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "maxLength": 40,
            "type": "string"
          },
          "horizon": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
            "type": "string"
          },
          "industry_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "invalidation": {
            "maxLength": 1800,
            "minLength": 1,
            "type": "string"
          },
          "issuer_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "materiality": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "observed_at": {
            "format": "date-time",
            "maxLength": 40,
            "type": "string"
          },
          "primary_source": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
            "type": "string"
          },
          "published_at": {
            "format": "date-time",
            "maxLength": 40,
            "type": "string"
          },
          "requires_a3_refresh": {
            "type": "boolean"
          },
          "score_contribution": {
            "const": 0,
            "type": "number"
          },
          "security_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "source_graph_artifact_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_graph_sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "DISCOVERED",
              "TRACK",
              "A3_RESEARCH",
              "WATCH",
              "REJECTED",
              "STALE",
              "BLOCKED"
            ]
          },
          "themes": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "tickers": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "transmission_channel": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
            "type": "string"
          },
          "underlyings": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,199}$",
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "verification_level": {
            "enum": [
              "V0",
              "V1",
              "V2"
            ]
          },
          "verified_fact": {
            "anyOf": [
              {
                "maxLength": 1800,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "event_id",
          "cohort_id",
          "event_family",
          "observed_at",
          "published_at",
          "available_at",
          "collected_at",
          "expires_at",
          "source_graph_artifact_id",
          "source_graph_sha256",
          "primary_source",
          "verification_level",
          "claim",
          "verified_fact",
          "issuer_ids",
          "security_ids",
          "tickers",
          "asset_ids",
          "themes",
          "industry_ids",
          "underlyings",
          "transmission_channel",
          "affected_pillars",
          "horizon",
          "materiality",
          "invalidation",
          "state",
          "assessment_eligible",
          "score_contribution",
          "requires_a3_refresh",
          "authority"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "research_only": {
      "const": true,
      "type": "boolean"
    },
    "schema_version": {
      "const": "a2-event-handoff-v1"
    }
  },
  "required": [
    "schema_version",
    "as_of",
    "events",
    "research_only",
    "authority"
  ],
  "type": "object"
}
