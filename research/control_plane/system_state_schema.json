{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "expires_at",
    "repository",
    "master_sha",
    "code_sha",
    "context",
    "g0",
    "requests",
    "completed_tasks",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "system-state-v2"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "const": "wscha231/r1000-quant-engine"
    },
    "review_pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "master_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "code_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_status_as_of",
        "current_status_freshness",
        "data_as_of",
        "actual_book",
        "approved_target",
        "thesis",
        "market_regime",
        "open_refs",
        "handoff_ref",
        "blockers"
      ],
      "properties": {
        "current_status_as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "current_status_freshness": {
          "enum": [
            "VERIFIED",
            "STALE",
            "UNKNOWN"
          ]
        },
        "data_as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "actual_book": {
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "BLOCKED",
            "STALE"
          ]
        },
        "approved_target": {
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "BLOCKED",
            "STALE"
          ]
        },
        "thesis": {
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "market_regime": {
          "enum": [
            "RISK_ON",
            "CAUTION",
            "RISK_OFF",
            "RECOVERY",
            "UNKNOWN"
          ]
        },
        "open_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "handoff_ref": {
          "type": "string",
          "minLength": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "g0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "BLOCKED",
            "UNKNOWN",
            "STALE",
            "PARTIAL",
            "PARTIAL_COVERAGE",
            "COLLECTED_NOT_PIT_CERTIFIED"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "inputs",
          "model",
          "parameters"
        ],
        "properties": {
          "agent": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "A7",
              "A8"
            ]
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/artifact"
            }
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "parameters": {
            "type": "object"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "completed_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "task_key",
          "status",
          "outputs",
          "schema_version",
          "identity",
          "source_hashes",
          "input_hashes",
          "dependency_identities",
          "code_sha",
          "config_hash",
          "model",
          "parameter_hash",
          "runtime_verification",
          "focused_tests",
          "ci",
          "side_effects",
          "reviewed_head",
          "created_at",
          "available_at",
          "verification_status",
          "execution_mode",
          "ai_invoked",
          "ai_invocation_reason"
        ],
        "properties": {
          "agent": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "A7",
              "A8"
            ]
          },
          "task_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "const": "SUCCEEDED"
          },
          "outputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/artifact"
            }
          },
          "schema_version": {
            "const": "verification-receipt-v2"
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_hash",
              "code_sha",
              "config_hash",
              "mission_contract_sha256",
              "model",
              "parameters"
            ],
            "properties": {
              "input_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "code_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "config_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "mission_contract_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "model": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "version"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "parameters": {
                "type": "object"
              }
            }
          },
          "source_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "input_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "dependency_identities": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_key",
                "output_hashes"
              ],
              "properties": {
                "task_key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "output_hashes": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "code_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "config_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "parameter_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "runtime_verification": {
            "$ref": "#/$defs/task_evidence"
          },
          "focused_tests": {
            "$ref": "#/$defs/task_evidence"
          },
          "ci": {
            "$ref": "#/$defs/task_evidence"
          },
          "side_effects": {
            "type": "array",
            "maxItems": 0
          },
          "reviewed_head": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "available_at": {
            "type": "string",
            "format": "date-time"
          },
          "verification_status": {
            "const": "VERIFIED"
          },
          "execution_mode": {
            "enum": [
              "DETERMINISTIC_CODE",
              "VERIFIED_EXISTING_ARTIFACT",
              "SKIP_UNCHANGED",
              "GENERAL_CHATGPT",
              "WORK",
              "CODEX"
            ]
          },
          "ai_invoked": {
            "type": "boolean"
          },
          "ai_invocation_reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "UNKNOWN"
            ]
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "execute",
        "target",
        "broker",
        "scheduler",
        "promotion",
        "peer_dispatch"
      ],
      "properties": {
        "research_only": {
          "const": true
        },
        "execute": {
          "const": false
        },
        "target": {
          "const": false
        },
        "broker": {
          "const": false
        },
        "scheduler": {
          "const": false
        },
        "promotion": {
          "const": false
        },
        "peer_dispatch": {
          "const": false
        },
        "research_allowed": {
          "type": "boolean"
        },
        "selector_allowed": {
          "const": false
        },
        "model_portfolio_allowed": {
          "type": "boolean"
        },
        "account_rebalance_allowed": {
          "const": false
        },
        "target_mutation_allowed": {
          "const": false
        },
        "paper_mutation_allowed": {
          "const": false
        },
        "broker_mutation_allowed": {
          "const": false
        },
        "fullrun_allowed": {
          "const": false
        },
        "production_activation_allowed": {
          "const": false
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "default_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "mission": {
      "type": "object"
    },
    "data": {
      "type": "object"
    },
    "books": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_broker",
        "approved_target",
        "verified_paper",
        "model_portfolio"
      ],
      "properties": {
        "actual_broker": {
          "$ref": "#/$defs/source_state"
        },
        "approved_target": {
          "$ref": "#/$defs/source_state"
        },
        "verified_paper": {
          "$ref": "#/$defs/source_state"
        },
        "model_portfolio": {
          "$ref": "#/$defs/source_state"
        }
      }
    },
    "regime": {
      "$ref": "#/$defs/source_state"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "open_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/source_descriptor"
        }
      }
    },
    "source_status": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source_state"
      }
    },
    "dependency_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "intake_sha256",
        "research_scope",
        "runtime_sha256"
      ],
      "properties": {
        "method": {
          "const": "canonical-source-readback"
        },
        "intake_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "research_scope": {
          "const": "ADMITTED_DATASETS_ONLY_NOT_RANKING_OR_A5_READINESS"
        },
        "runtime_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A0 canonical materialized state and internal proposal-planning fields",
  "$defs": {
    "task_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "reference",
        "status",
        "head_sha",
        "available_at"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "PASS"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "observed_at",
        "available_at",
        "collected_at",
        "expires_at",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "const": "VERIFIED"
        }
      }
    },
    "qa_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifacts"
      ],
      "properties": {
        "schema_version": {
          "const": "qa-review-bundle-v2"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "qa_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "review_bundle_sha256",
        "reviewed_artifacts",
        "verdict"
      ],
      "properties": {
        "schema_version": {
          "const": "qa-report-v2"
        },
        "review_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed_artifacts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "source_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "observed_at",
        "available_at",
        "collected_at",
        "expires_at",
        "status",
        "identity"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "const": "VERIFIED"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "expires_at",
        "sources"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "mission": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "execution": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "commit": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "catalog": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "quality": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "drive_readback": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "control": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "current_status": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "actual_broker": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "approved_target": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "verified_paper": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "model_portfolio": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "regime": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            }
          }
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "completed_tasks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "source_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifact_identity",
        "sha256",
        "as_of",
        "availability",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "BLOCKED",
            "STALE"
          ]
        },
        "artifact_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "availability": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "claim_boundary": {
          "const": "NOT_ACTUAL_HOLDINGS"
        },
        "value": {
          "const": "UNKNOWN"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "materialization"
        ]
      },
      "then": {
        "required": [
          "generated_at",
          "default_branch",
          "mission",
          "data",
          "books",
          "regime",
          "blockers",
          "dependencies",
          "open_refs",
          "source_identity",
          "source_status",
          "dependency_identity",
          "state_sha256",
          "materialization"
        ]
      }
    }
  ]
}
