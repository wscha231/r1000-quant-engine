{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "expires_at",
    "repository",
    "master_sha",
    "code_sha",
    "context",
    "g0",
    "requests",
    "completed_tasks",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "system-state-v2"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "const": "wscha231/r1000-quant-engine"
    },
    "review_pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "master_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "code_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_status_as_of",
        "current_status_freshness",
        "data_as_of",
        "actual_book",
        "approved_target",
        "thesis",
        "market_regime",
        "open_refs",
        "handoff_ref",
        "blockers"
      ],
      "properties": {
        "current_status_as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "current_status_freshness": {
          "enum": [
            "VERIFIED",
            "STALE",
            "UNKNOWN"
          ]
        },
        "data_as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "actual_book": {
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "approved_target": {
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "thesis": {
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "market_regime": {
          "enum": [
            "RISK_ON",
            "CAUTION",
            "RISK_OFF",
            "RECOVERY",
            "UNKNOWN"
          ]
        },
        "open_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "handoff_ref": {
          "type": "string",
          "minLength": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "g0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "BLOCKED",
            "UNKNOWN"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "inputs",
          "model",
          "parameters"
        ],
        "properties": {
          "agent": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "A7",
              "A8"
            ]
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/artifact"
            }
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "parameters": {
            "type": "object"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "completed_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "task_key",
          "status",
          "outputs",
          "schema_version",
          "identity",
          "source_hashes",
          "input_hashes",
          "dependency_identities",
          "code_sha",
          "config_hash",
          "model",
          "parameter_hash",
          "runtime_verification",
          "focused_tests",
          "ci",
          "side_effects",
          "reviewed_head",
          "created_at",
          "available_at",
          "verification_status",
          "execution_mode",
          "ai_invoked",
          "ai_invocation_reason"
        ],
        "properties": {
          "agent": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "A7",
              "A8"
            ]
          },
          "task_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "const": "SUCCEEDED"
          },
          "outputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/artifact"
            }
          },
          "schema_version": {
            "const": "verification-receipt-v2"
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_hash",
              "code_sha",
              "config_hash",
              "model",
              "parameters"
            ],
            "properties": {
              "input_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "code_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "config_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "model": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "version"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "parameters": {
                "type": "object"
              }
            }
          },
          "source_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "input_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "dependency_identities": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_key",
                "output_hashes"
              ],
              "properties": {
                "task_key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "output_hashes": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "code_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "config_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "parameter_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "runtime_verification": {
            "$ref": "#/$defs/task_evidence"
          },
          "focused_tests": {
            "$ref": "#/$defs/task_evidence"
          },
          "ci": {
            "$ref": "#/$defs/task_evidence"
          },
          "side_effects": {
            "type": "array",
            "maxItems": 0
          },
          "reviewed_head": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "available_at": {
            "type": "string",
            "format": "date-time"
          },
          "verification_status": {
            "const": "VERIFIED"
          },
          "execution_mode": {
            "enum": [
              "DETERMINISTIC_CODE",
              "VERIFIED_EXISTING_ARTIFACT",
              "SKIP_UNCHANGED",
              "GENERAL_CHATGPT",
              "WORK",
              "CODEX"
            ]
          },
          "ai_invoked": {
            "type": "boolean"
          },
          "ai_invocation_reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "UNKNOWN"
            ]
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "execute",
        "target",
        "broker",
        "scheduler",
        "promotion",
        "peer_dispatch"
      ],
      "properties": {
        "research_only": {
          "const": true
        },
        "execute": {
          "const": false
        },
        "target": {
          "const": false
        },
        "broker": {
          "const": false
        },
        "scheduler": {
          "const": false
        },
        "promotion": {
          "const": false
        },
        "peer_dispatch": {
          "const": false
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A0 operator-supplied state; declarations are not economic certification",
  "$defs": {
    "task_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "reference", "status", "head_sha", "available_at"],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "PASS"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "observed_at",
        "available_at",
        "collected_at",
        "expires_at",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "const": "VERIFIED"
        }
      }
    },
    "qa_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifacts"
      ],
      "properties": {
        "schema_version": {
          "const": "qa-review-bundle-v2"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "qa_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "review_bundle_sha256",
        "reviewed_artifacts",
        "verdict"
      ],
      "properties": {
        "schema_version": {
          "const": "qa-report-v2"
        },
        "review_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed_artifacts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    }
  }
}
