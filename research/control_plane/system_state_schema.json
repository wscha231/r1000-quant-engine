{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "expires_at",
    "repository",
    "master_sha",
    "code_sha",
    "context",
    "g0",
    "requests",
    "completed_tasks",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "system-state-v2"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "const": "wscha231/r1000-quant-engine"
    },
    "review_pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "master_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "code_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_status_as_of",
        "current_status_freshness",
        "data_as_of",
        "actual_book",
        "approved_target",
        "thesis",
        "market_regime",
        "open_refs",
        "handoff_ref",
        "blockers"
      ],
      "properties": {
        "current_status_as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "current_status_freshness": {
          "enum": [
            "VERIFIED",
            "STALE",
            "UNKNOWN"
          ]
        },
        "data_as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "actual_book": {
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "BLOCKED",
            "STALE"
          ]
        },
        "approved_target": {
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "BLOCKED",
            "STALE"
          ]
        },
        "thesis": {
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "market_regime": {
          "enum": [
            "RISK_ON",
            "CAUTION",
            "RISK_OFF",
            "RECOVERY",
            "UNKNOWN"
          ]
        },
        "open_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "handoff_ref": {
          "type": "string",
          "minLength": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "account_only_blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "g0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "BLOCKED",
            "UNKNOWN",
            "STALE",
            "PARTIAL",
            "PARTIAL_COVERAGE",
            "COLLECTED_NOT_PIT_CERTIFIED"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "inputs",
          "model",
          "parameters"
        ],
        "properties": {
          "agent": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "A7",
              "A8"
            ]
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/artifact"
            }
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "parameters": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "agent": {
                  "const": "A5"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "properties": {
                    "portfolio_mode": {
                      "enum": [
                        "ACCOUNT_REBALANCE",
                        "MODEL_PORTFOLIO"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "completed_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "task_key",
          "status",
          "outputs",
          "schema_version",
          "identity",
          "source_hashes",
          "input_hashes",
          "dependency_identities",
          "code_sha",
          "config_hash",
          "model",
          "parameter_hash",
          "runtime_verification",
          "focused_tests",
          "ci",
          "side_effects",
          "reviewed_head",
          "created_at",
          "available_at",
          "verification_status",
          "execution_mode",
          "ai_invoked",
          "ai_invocation_reason"
        ],
        "properties": {
          "agent": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "A7",
              "A8"
            ]
          },
          "task_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "const": "SUCCEEDED"
          },
          "outputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/artifact"
            }
          },
          "schema_version": {
            "const": "verification-receipt-v2"
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_hash",
              "code_sha",
              "config_hash",
              "mission_contract_sha256",
              "model",
              "parameters"
            ],
            "properties": {
              "input_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "code_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "config_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "mission_contract_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "model": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "version"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "parameters": {
                "type": "object"
              }
            }
          },
          "source_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "input_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "dependency_identities": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_key",
                "output_hashes"
              ],
              "properties": {
                "task_key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "output_hashes": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "code_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "config_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "parameter_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "runtime_verification": {
            "$ref": "#/$defs/task_evidence"
          },
          "focused_tests": {
            "$ref": "#/$defs/task_evidence"
          },
          "ci": {
            "$ref": "#/$defs/task_evidence"
          },
          "side_effects": {
            "type": "array",
            "maxItems": 0
          },
          "reviewed_head": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "available_at": {
            "type": "string",
            "format": "date-time"
          },
          "verification_status": {
            "const": "VERIFIED"
          },
          "execution_mode": {
            "enum": [
              "DETERMINISTIC_CODE",
              "VERIFIED_EXISTING_ARTIFACT",
              "SKIP_UNCHANGED",
              "GENERAL_CHATGPT",
              "WORK",
              "CODEX"
            ]
          },
          "ai_invoked": {
            "type": "boolean"
          },
          "ai_invocation_reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "UNKNOWN"
            ]
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "execute",
        "target",
        "broker",
        "scheduler",
        "promotion",
        "peer_dispatch"
      ],
      "properties": {
        "research_only": {
          "const": true
        },
        "execute": {
          "const": false
        },
        "target": {
          "const": false
        },
        "broker": {
          "const": false
        },
        "scheduler": {
          "const": false
        },
        "promotion": {
          "const": false
        },
        "peer_dispatch": {
          "const": false
        },
        "research_allowed": {
          "type": "boolean"
        },
        "selector_allowed": {
          "const": false
        },
        "model_portfolio_allowed": {
          "type": "boolean"
        },
        "account_rebalance_allowed": {
          "const": false
        },
        "target_mutation_allowed": {
          "const": false
        },
        "paper_mutation_allowed": {
          "const": false
        },
        "broker_mutation_allowed": {
          "const": false
        },
        "fullrun_allowed": {
          "const": false
        },
        "production_activation_allowed": {
          "const": false
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "default_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "mission": {
      "type": "object"
    },
    "data": {
      "type": "object"
    },
    "books": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_broker",
        "approved_target",
        "verified_paper",
        "model_portfolio"
      ],
      "properties": {
        "actual_broker": {
          "$ref": "#/$defs/source_state"
        },
        "approved_target": {
          "$ref": "#/$defs/source_state"
        },
        "verified_paper": {
          "$ref": "#/$defs/source_state"
        },
        "model_portfolio": {
          "$ref": "#/$defs/source_state"
        }
      }
    },
    "regime": {
      "$ref": "#/$defs/source_state"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "open_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/source_descriptor"
        }
      }
    },
    "source_status": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source_state"
      }
    },
    "dependency_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "intake_sha256",
        "research_scope",
        "runtime_sha256"
      ],
      "properties": {
        "method": {
          "const": "canonical-source-readback"
        },
        "intake_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "research_scope": {
          "const": "ADMITTED_DATASETS_ONLY_NOT_RANKING_OR_A5_READINESS"
        },
        "runtime_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A0 canonical materialized state and internal proposal-planning fields",
  "$defs": {
    "current_a3_review_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portfolio_context", "review_graph"],
      "properties": {
        "portfolio_context": {"$ref": "#/$defs/artifact"},
        "review_graph": {"$ref": "#/$defs/artifact"}
      }
    },
    "task_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "reference",
        "status",
        "head_sha",
        "available_at"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "PASS"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "observed_at",
        "available_at",
        "collected_at",
        "expires_at",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "const": "VERIFIED"
        }
      }
    },
    "qa_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifacts"
      ],
      "properties": {
        "schema_version": {
          "const": "qa-review-bundle-v2"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "qa_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "review_bundle_sha256",
        "reviewed_artifacts",
        "verdict"
      ],
      "properties": {
        "schema_version": {
          "const": "qa-report-v2"
        },
        "review_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed_artifacts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "source_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "observed_at",
        "available_at",
        "collected_at",
        "expires_at",
        "status",
        "identity"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "const": "VERIFIED"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "expires_at",
        "sources"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "mission": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "execution": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "commit": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "catalog": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "quality": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "drive_readback": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "control": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "current_status": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "actual_broker": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "approved_target": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "verified_paper": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "model_portfolio": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            },
            "regime": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_descriptor"
              }
            }
          }
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "completed_tasks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "source_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifact_identity",
        "sha256",
        "as_of",
        "availability",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "BLOCKED",
            "STALE"
          ]
        },
        "artifact_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "availability": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "claim_boundary": {
          "const": "NOT_ACTUAL_HOLDINGS"
        },
        "value": {
          "const": "UNKNOWN"
        }
      }
    },
    "a5_portfolio_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "portfolio_mode",
        "decision_time",
        "market_session_date",
        "requested_security_ids",
        "a3_reference_entries",
        "artifact_inventory",
        "model_state",
        "a4_request",
        "a4_source_root"
      ],
      "properties": {
        "schema_version": {
          "const": "a5-portfolio-context-v1"
        },
        "portfolio_mode": {
          "const": "MODEL_PORTFOLIO"
        },
        "decision_time": {
          "type": "string",
          "format": "date-time"
        },
        "market_session_date": {
          "type": "string",
          "format": "date"
        },
        "requested_security_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "a3_reference_entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "issuer_id",
              "a3_packet_ref",
              "a3_result_ref"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "issuer_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "a3_packet_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_id",
                  "sha256",
                  "available_at",
                  "collected_at",
                  "expires_at"
                ],
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "available_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "collected_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "expires_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                }
              },
              "a3_result_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_id",
                  "sha256",
                  "available_at",
                  "collected_at",
                  "expires_at"
                ],
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "available_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "collected_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "expires_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "artifact_inventory": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 256,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        },
        "model_state": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "artifact"
              ],
              "properties": {
                "kind": {
                  "const": "GENESIS"
                },
                "artifact": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "artifact",
                "model_identity"
              ],
              "properties": {
                "kind": {
                  "enum": ["INCUMBENTS", "PARENT_LINEAGE_ONLY"]
                },
                "model_identity": {"$ref": "#/$defs/current_model_identity"},
                "artifact": {
                  "$ref": "#/$defs/artifact"
                }
              }
            }
          ]
        },
        "a4_request": {
          "$ref": "#/$defs/artifact"
        },
        "a4_source_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "current_model_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "model_version", "model_code_sha", "model_config_sha256",
                   "model_recipe_sha256", "data_identity_sha256", "cost_context_sha256"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 200},
        "model_code_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$",
          "description": "Model implementation revision in the original allocation and externally reviewed context; distinct from producer and current consumer code identities."},
        "model_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_recipe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "data_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cost_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "model_allocation_positions": {
      "type": "array", "minItems": 0, "maxItems": 1000,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["asset_id", "weight"],
        "properties": {"asset_id": {"type": "string", "minLength": 1, "maxLength": 80},
                       "weight": {"type": "number", "minimum": 0, "maximum": 1}}}
    },
    "model_allocation_state": {
      "type": "object", "additionalProperties": false,
      "dependentRequired": {
        "parent_state_sha256": ["parent_acceptance_sha256", "assessment_kind", "assessment_inputs_sha256", "assessment_source_sha256"],
        "parent_acceptance_sha256": ["parent_state_sha256", "assessment_kind", "assessment_inputs_sha256", "assessment_source_sha256"]
      },
      "allOf": [{"if": {"required": ["assessment_kind"], "properties": {
        "assessment_kind": {"enum": ["ALLOCATION_CHANGE", "HOLD_REAFFIRMATION"]}}},
        "then": {"required": ["parent_state_sha256", "parent_acceptance_sha256"]}}],
      "required": ["schema_version", "state_role", "model_identity", "as_of", "decision_time",
                   "positions", "cash_weight", "origin_a5_task_key", "actual_holdings_claimed", "execution_or_performance_claimed"],
      "properties": {
        "schema_version": {"const": "model-allocation-state-v1"},
        "state_role": {"const": "MODEL_ALLOCATION_STATE"},
        "model_identity": {"$ref": "#/$defs/current_model_identity"},
        "as_of": {"type": "string", "format": "date"},
        "decision_time": {"type": "string", "format": "date-time"},
        "positions": {"$ref": "#/$defs/model_allocation_positions"},
        "cash_weight": {"type": "number", "minimum": 0, "maximum": 1,
          "description": "Explicit MODEL cash allocation, not an inferred cash balance or cash-return admission."},
        "origin_a5_task_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "assessment_kind": {"enum": ["INITIAL_ALLOCATION", "ALLOCATION_CHANGE", "HOLD_REAFFIRMATION"]},
        "assessment_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "assessment_inputs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "parent_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "parent_acceptance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "actual_holdings_claimed": {"const": false},
        "execution_or_performance_claimed": {"const": false}
      }
    },
    "model_allocation_selection": {
      "type": "object", "additionalProperties": false,
      "description": "Original owner selection submitted for independent review; the document alone grants no acceptance or future standing authority.",
      "required": ["schema_version", "change_kind", "owner_principal", "selected_at", "expires_at", "reason",
                   "proposal_receipt_sha256", "a5_packet", "a5_receipt", "model_identity", "positions", "cash_weight"],
      "properties": {
        "schema_version": {"const": "model-allocation-selection-v1"},
        "change_kind": {"enum": ["SELECT_ALLOCATION", "REAFFIRM_HOLD", "NO_CHANGE"]},
        "owner_principal": {"type": "string", "minLength": 1, "maxLength": 80},
        "selected_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "proposal_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "a5_packet": {"$ref": "#/$defs/artifact"},
        "a5_receipt": {"$ref": "#/$defs/artifact"},
        "model_identity": {"$ref": "#/$defs/current_model_identity"},
        "positions": {"$ref": "#/$defs/model_allocation_positions"},
        "cash_weight": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "model_incumbents_acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "book_kind", "state_role", "current", "model_identity", "as_of",
                   "decision_time", "expires_at", "positions", "cash_weight", "positions_sha256", "producer_code_sha",
                   "producer_config_hash", "principals", "proofs", "observed_at", "available_at",
                   "collected_at", "source", "data_quality", "evidence_kind", "raw_sha256"],
      "properties": {
        "schema_version": {"const": "model-incumbents-acceptance-v1"},
        "book_kind": {"const": "MODEL"},
        "state_role": {"const": "ADMITTED_MODEL_ALLOCATION"},
        "current": {"const": true,
          "description": "Active allocation acceptance inside its original validity window, not an attestation of current-session executed holdings."},
        "model_identity": {"$ref": "#/$defs/current_model_identity"},
        "as_of": {"type": "string", "format": "date"},
        "decision_time": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "positions": {"$ref": "#/$defs/model_allocation_positions"},
        "cash_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "positions_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$",
          "description": "Existing multi_asset.contracts.digest: canonical UTF-8 JSON plus LF; distinct from board task identity digests."},
        "producer_code_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$",
          "description": "Original A5/A6 orchestration revision, bound to their immutable task/completion evidence; not silently replaced by current consumer HEAD."},
        "producer_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "principals": {"type": "object", "additionalProperties": false, "required": ["A5", "A6"],
          "properties": {"A5": {"type": "string", "minLength": 1, "maxLength": 80},
                         "A6": {"type": "string", "minLength": 1, "maxLength": 80}}},
        "proofs": {"type": "object", "additionalProperties": false,
          "required": ["state", "a5_packet", "a5_receipt", "a6_packet", "a6_receipt"],
          "properties": {"state": {"$ref": "#/$defs/artifact"},
                         "a5_packet": {"$ref": "#/$defs/artifact"},
                         "a5_receipt": {"$ref": "#/$defs/artifact"},
                         "a6_packet": {"$ref": "#/$defs/artifact"},
                         "a6_receipt": {"$ref": "#/$defs/artifact"},
                         "parent_acceptance": {"$ref": "#/$defs/artifact"},
                         "parent_state": {"$ref": "#/$defs/artifact"}}},
        "observed_at": {"type": "string", "format": "date-time"},
        "available_at": {"type": "string", "format": "date-time"},
        "collected_at": {"type": "string", "format": "date-time"},
        "source": {"type": "string", "minLength": 1, "maxLength": 200},
        "data_quality": {"const": "OBSERVED"},
        "evidence_kind": {"const": "FORWARD_CAPTURE"},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "materialization"
        ]
      },
      "then": {
        "required": [
          "generated_at",
          "default_branch",
          "mission",
          "data",
          "books",
          "regime",
          "blockers",
          "dependencies",
          "open_refs",
          "source_identity",
          "source_status",
          "dependency_identity",
          "state_sha256",
          "materialization"
        ]
      }
    }
  ]
}
