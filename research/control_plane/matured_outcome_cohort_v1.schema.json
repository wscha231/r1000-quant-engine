{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matured outcome cohort V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "rows",
    "coverage_status",
    "learning_eligible",
    "research_only",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "matured-outcome-cohort-v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "session_clock",
          "target_calendar_sha256",
          "data_manifest_sha256",
          "config_sha256",
          "model_sha256",
          "model_id",
          "issuer_id",
          "security_id",
          "asset_id",
          "decision_id",
          "cohort_id",
          "benchmark_id",
          "decision_at",
          "horizon",
          "target_session",
          "status",
          "asset_return",
          "benchmark_return",
          "excess_return",
          "source_sha256",
          "outcome_session",
          "outcome_available_at",
          "include_in_denominator"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "security_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "benchmark_id": {
            "type": "string",
            "minLength": 1
          },
          "decision_at": {
            "type": "string",
            "format": "date-time"
          },
          "horizon": {
            "enum": [
              "1D",
              "1W",
              "2W",
              "1M",
              "3M",
              "6M",
              "12M"
            ]
          },
          "target_session": {
            "type": "string",
            "minLength": 10
          },
          "status": {
            "enum": [
              "MATURED",
              "UNRESOLVED",
              "DELISTED_OR_EXITED_PENDING"
            ]
          },
          "asset_return": {
            "type": [
              "number",
              "null"
            ]
          },
          "benchmark_return": {
            "type": [
              "number",
              "null"
            ]
          },
          "excess_return": {
            "type": [
              "number",
              "null"
            ]
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "cohort_id": {
            "type": "string",
            "minLength": 1
          },
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "issuer_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "model_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "data_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "target_calendar_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "session_clock": {
            "enum": [
              "NYSE_CLOSE",
              "UTC_DAY"
            ]
          },
          "outcome_session": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome_available_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "include_in_denominator": {
            "const": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "MATURED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "asset_return": {
                  "type": "number"
                },
                "benchmark_return": {
                  "type": "number"
                },
                "excess_return": {
                  "type": "number"
                },
                "outcome_session": {
                  "type": "string",
                  "minLength": 10
                },
                "outcome_available_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "UNRESOLVED",
                    "DELISTED_OR_EXITED_PENDING"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "asset_return": {
                  "const": null
                },
                "benchmark_return": {
                  "const": null
                },
                "excess_return": {
                  "const": null
                },
                "outcome_session": {
                  "const": null
                },
                "outcome_available_at": {
                  "const": null
                }
              }
            }
          }
        ]
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_model_update",
        "automatic_champion_promotion",
        "target",
        "orders"
      ],
      "properties": {
        "automatic_model_update": {
          "const": false
        },
        "automatic_champion_promotion": {
          "const": false
        },
        "target": {
          "const": false
        },
        "orders": {
          "const": false
        }
      }
    },
    "coverage_status": {
      "enum": [
        "INCOMPLETE",
        "COMPLETE_EXACT"
      ]
    },
    "learning_eligible": {
      "type": "boolean"
    },
    "research_only": {
      "const": true
    }
  }
}
