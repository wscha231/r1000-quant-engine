    "output": "theme_etf_bridge.json",
    "downstream": {
      "universe_reason_consumer": "PR445_PENDING",
      "candidate_packet_consumer": "PR451_PENDING",
      "news_consumer": "PR459_PENDING",
      "company_evaluator": "NOT_CONNECTED"
