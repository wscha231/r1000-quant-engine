{
  "schema_version": "run287-same-close-target-contract-v1",
  "scope": "forward paper target generation after one completed NYSE close",
  "required_timestamp_fields": [
    "signal_source_date",
    "feature_as_of_date",
    "valuation_close_date",
    "selector_decision_time_utc",
    "target_effective_date",
    "order_eligible_close_date",
    "same_close_selector_recomputed"
  ],
  "selector_scenarios": {
    "main": "prior_hold_transition_bridge",
    "concentrated": "strict_registered_current"
  },
  "active_prediction_heads": [
    "pred_lin_ret",
    "pred_lin_p",
    "pred_future_winner_ret",
    "pred_future_winner_p",
    "pred_cat_ret",
    "pred_cat_p"
  ],
  "prediction_head_gate": "every head must be finite, nonzero, and nonconstant",
  "freshness_and_candidate_coverage": {
    "pre_refresh_freshness": "strict source/session gate; restored scored_latest coverage is diagnostic only",
    "pre_refresh_readiness_gate": "exact_packet_preselection",
    "deferred_policy_replay_checks": "universe health and enriched candidate source/hash readiness must be revalidated by the attempt-specific exact-packet chain before target materialization",
    "authoritative_source": "attempt-specific run287-scored-latest-refresh-v4 output",
    "minimum_complete_ratio": 0.98,
    "hard_pit_violation_tolerance": 0,
    "hard_pit_violations": [
      "invalid or placeholder ticker",
      "non-positive or non-finite close price",
      "valuation date mismatch",
      "future feature availability"
    ],
    "denominator": "post-lifecycle candidate count",
    "required_identity": [
      "scored_latest_sha256",
      "expected_ticker_set_sha256",
      "valuation_price_cutoff_date",
      "feature_available_from",
      "score_available_from"
    ],
    "ranking_eligibility_is_separate": true,
    "exact_packet_lineage": [
      "decision -> scored latest and macro",
      "score stack -> decision",
      "crisis -> macro",
      "SOXX -> crisis"
    ],
    "relative_strength_benchmarks": {
      "macro_isolated_and_rehashed": ["SPY", "QQQ", "SMH"],
      "separate_manifest_bound": ["SOXX"]
    },
    "upstream_preflight_binding": [
      "nine fixed scorer input hashes",
      "universe and pre/post-lifecycle ticker-set identity",
      "consumed historical price-cache fingerprints"
    ],
    "refreshed_feature_available_from": "max(inherited availability, actual scheduled NYSE close)",
    "holding_available_from_must_be_valid_and_not_future": true
  },
  "risk_intersection": {
    "new_entry": "selector alpha admits the candidate only when exact-date candidate risk is NORMAL",
    "held_incremental_buy": "cap at marked weight when held state is ALERT or WATCH or action freezes incremental buys",
    "released_weight": "retain as CASH without reallocating to another security",
    "missing": "neutral for alpha features but fail closed for a proposed new-entry risk row"
  },
  "turnover_and_cost": {
    "cash_included_in_turnover": true,
    "cash_excluded_from_equity_fee": true,
    "fee_sensitivity_bps_per_asset_side": [25, 50, 100]
  },
  "execution": {
    "fill_mode": "next_close",
    "target_effective_date": "valuation_close_date",
    "order_eligible_close_date": "first NYSE session strictly after valuation_close_date",
    "integer_shares": true
  },
  "safety": {
    "paper_only": true,
    "production_activation_allowed": false,
    "live_trading_allowed": false,
    "fullrun_allowed": false,
    "pit_universe_label_clean": false,
    "restored_target_may_set_same_close_selector_recomputed": false,
    "current_attempt_upstream_status_required": true,
    "producer_schema_and_exact_ready_status_required": true,
    "producer_contract_sha256_required": true,
    "existing_packet_input_identity_required": true,
    "skipped_stage_may_reuse_restored_ready_marker": false,
    "blocked_rerun_removes_prior_run_local_targets": true,
    "blocked_rerun_preserves_accepted_ledger_and_canonical_state": true
  }
}
