{
  "schema_version": "run287-recovery-price-evidence-contract-v1",
  "output_schema_version": "run287-recovery-price-evidence-v1",
  "required_status": "READY_REVIEW_ONLY_RECOVERY_PRICE_EVIDENCE",
  "repository": "wscha231/r1000-quant-engine",
  "default_branch": "master",
  "accepted_paper": {
    "workflow_path": ".github/workflows/daily_operating_selection_refresh.yml",
    "artifact_name_pattern": "^accepted-paper-(?:catchup-[0-9]{4}-[0-9]{2}-[0-9]{2}-|transaction-)[1-9][0-9]*$",
    "state_relative_path": "outputs/daily_simulated_fill_ledger",
    "required_integrity_schema": "run287-paper-ledger-snapshot-integrity-v2"
  },
  "after_close_anchor": {
    "workflow_path": ".github/workflows/after_close_daily.yml",
    "artifact_name_pattern": "^after-close-daily-[1-9][0-9]*$",
    "summary_relative_path": "cloud_results/theme_leadership_tape/summary.json",
    "ticker_relative_path": "cloud_results/theme_leadership_tape/ticker_leadership.csv",
    "minimum_operating_ticker_overlap_ratio": 0.5,
    "minimum_operating_ticker_overlap_count": 5,
    "close_relative_tolerance": 1e-08,
    "volume_relative_tolerance": 1e-08
  },
  "price_cache": {
    "required_manifest_schema": "run287-replay-price-cache-manifest-v2",
    "required_benchmark_tickers": [
      "QQQ",
      "SMH",
      "SOXX",
      "SPY"
    ],
    "required_exact_close_coverage": 1.0,
    "future_rows_allowed": false,
    "prior_session_fallback_allowed": false,
    "extra_tickers_allowed": false
  },
  "safety": {
    "review_only": true,
    "catchup_consumption_allowed": false,
    "network_allowed_only_in_manual_evidence_workflow": true,
    "backtest_allowed": false,
    "fullrun_allowed": false,
    "orders_allowed": false,
    "target_book_mutation_allowed": false,
    "paper_ledger_mutation_allowed": false,
    "durable_state_mutation_allowed": false,
    "production_mutation_allowed": false,
    "live_trading_allowed": false,
    "automatic_promotion_allowed": false
  }
}
