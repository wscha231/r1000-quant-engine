{
  "schema": "a3-candidate-packet-v1-contract",
  "version": 1,
  "purpose": "Aggregate reviewed Methodology V1, Moat V2, market/valuation, source graph, scenario research and optional walk-forward validated ER without granting selector/portfolio/order authority.",
  "required_artifacts": [
    "METHODOLOGY_RESULT",
    "MARKET_VALUATION_SNAPSHOT",
    "SOURCE_GRAPH"
  ],
  "conditional_artifacts": {
    "moat": "Required for company/securities when moat_applicability=REQUIRED; omitted for non-company underlyings.",
    "validated_er": "Optional; only WALK_FORWARD_VALIDATED, net-of-costs ER may populate validated expected-return fields."
  },
  "scenario_research": {
    "horizons": [
      "12m",
      "24m"
    ],
    "cases": [
      "bear",
      "base",
      "bull"
    ],
    "probabilities_allowed": false,
    "reason": "Unvalidated scenario probabilities must not be converted into statistical expected return.",
    "ordered_returns_required": true
  },
  "validated_er": {
    "horizons": [
      "1m",
      "3m",
      "6m",
      "12m"
    ],
    "validation_status": "WALK_FORWARD_VALIDATED",
    "net_of_costs_required": true,
    "benchmark_identity_must_match_market_snapshot": true,
    "unit": "RETURN_FRACTION"
  },
  "artifact_integrity": {
    "reviewed_status_required": true,
    "actual_bytes_must_resolve": true,
    "sha256_must_match_resolved_bytes": true,
    "available_at_must_not_exceed_packet_as_of": true,
    "asset_identity_must_match": true,
    "issuer_identity_required_for": [
      "METHODOLOGY_RESULT",
      "MOAT_RESULT",
      "SOURCE_GRAPH"
    ]
  },
  "statuses": [
    "SCENARIO_RESEARCH_COMPLETE",
    "VALIDATED_ER_LINKED"
  ],
  "authority": {
    "historical_pit_certified": false,
    "selector_eligible": false,
    "portfolio_weight_effect": 0,
    "target_book_write_allowed": false,
    "orders_allowed": false,
    "production_authority": false
  },
  "market_snapshot": {
    "schema": "a3-market-valuation-snapshot-v1",
    "completed_session_required": true,
    "return_basis_allowed": [
      "TOTAL_RETURN",
      "PROVIDER_ADJUSTED_CLOSE_PROXY"
    ],
    "horizons_trading_days": [
      20,
      60,
      120,
      240
    ],
    "rs_method": "LOG_RELATIVE_RETURN",
    "rs_formula": "log(1 + asset_return_h) - log(1 + benchmark_return_h)",
    "formula_recomputed_by_validator": true
  },
  "source_graph": {
    "schema": "a3-source-graph-v1",
    "source_types": [
      "SEC_FILING",
      "COMPANY_IR",
      "CUSTOMER_DISCLOSURE",
      "GOVERNMENT",
      "REGULATOR",
      "CENTRAL_BANK",
      "EXCHANGE",
      "COURT",
      "PATENT_RECORD",
      "INDUSTRY_DATA",
      "MARKET_DATA",
      "REUTERS",
      "OTHER_INDEPENDENT_MEDIA",
      "TELEGRAM_SECONDARY"
    ],
    "verification_tiers": [
      "V0",
      "V1",
      "V2"
    ],
    "telegram_secondary_policy": "V0 discovery only; used_for_assessment=false and investment_score_contribution_allowed=false.",
    "assessment_sources_require_verified_tier": true,
    "minimum_independent_assessment_groups": 2,
    "independent_noncommunity_corroboration_required": true,
    "each_source_requires": [
      "source_id",
      "claim_id",
      "source_type",
      "source_affiliation",
      "verification_tier",
      "independence_group",
      "published_at",
      "available_at",
      "raw_artifact_id",
      "raw_sha256",
      "claim",
      "supports_pillars",
      "used_for_assessment",
      "investment_score_contribution_allowed"
    ],
    "raw_source_bytes_must_resolve_and_match_sha256": true,
    "source_available_at_must_not_exceed_graph_as_of": true,
    "graph_as_of_must_not_exceed_packet_as_of": true
  }
}
