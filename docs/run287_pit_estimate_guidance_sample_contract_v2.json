    "unit",
    "observed_at",
    "available_from",
    "revision_of_event_id",
    "source_hash"
  ],
  "event_required_nonempty_columns": [
    "provider",
    "event_id",
    "issuer_id",
    "security_id",
    "listing_id",
    "ticker",
    "event_type",
    "metric",
    "fiscal_period_end",
    "fiscal_period_type",
    "value_role",
    "value",
    "currency",
    "unit",
    "observed_at",
    "available_from",
    "source_hash"
  ],
  "asof_query_required_columns": [
