{
  "schema_version": "run287-pit-estimate-guidance-sample-contract-v2",
  "purpose": "Fail-closed schema, point-in-time, identity, reproducibility, and rights gate before any alpha screen.",
  "window_start": "2019-06-03",
  "window_end": "2026-07-10",
  "sample_selection_seed": "run287-pit-estimate-guidance-50-security-v2",
  "sample_strata_exact_counts": {
    "active_us": 20,
    "delisted": 10,
    "adr_home": 10,
    "predecessor_corporate_action": 10
  },
  "minimums": {
    "unique_security_count": 50,
