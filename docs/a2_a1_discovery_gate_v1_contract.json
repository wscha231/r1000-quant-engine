{
  "schema": "a2-a1-discovery-gate-v1-contract",
  "stage": 2,
  "mode": "DRY_RUN_SUPPLIED_BYTES_ONLY",
  "entrypoint": "research/a2_a1_discovery_gate_v1.py:select_discovery",
  "reuse": ["research/a2_research_intake_v1.py", "research/a3_candidate_packet_v1.py", "research/control_plane/a2_event_handoff_v1.schema.json"],
  "inputs": ["existing a2-event-handoff-v1 bytes", "a2-a1-discovery-context-v1 bytes", "explicit past/current cutoff", "sealed bounded MemoryArtifacts"],
  "context_fields": ["schema", "identities", "origins", "prior_event_keys", "prior_request_event_keys", "registry_security_ids", "registry_theme_ids"],
  "identity_fields": ["security_id", "issuer_id", "ticker", "country", "currency", "mic", "valid_from", "valid_until", "evidence_ref"],
  "identity_evidence_schema": "a2-discovery-security-identity-v1",
  "origin_fields": ["event_id", "primary_source_id", "original_url", "materiality_basis"],
  "rejections": ["V0", "rumor/community/price-only", "missing material fact or basis", "invalid raw or graph bytes", "wrong security/ticker/issuer/currency/MIC", "expired lifecycle", "missing or conflicting original publication", "future/stale evidence", "ambiguous identity", "global active caps exceeded"],
  "dedup": "SHA256 of canonical security/issuer/event-family/primary-raw-SHA/normalized-publication; prior keys are supplied assertions only, Registry presence does not prove price coverage",
  "active_caps": {"securities_including_supplied_registry": 30, "themes_including_supplied_registry": 10},
  "url_policy": "HTTPS without credentials, query or fragment; only exact DART dsaf001/main.do?rcpNo=14digits query is allowed",
  "result": "a2-a1-discovery-selection-v1; candidates plus blocked/duplicate proposals; no data-acquisition request emitted",
  "identity_authentication": "NOT_VERIFIED",
  "source_authentication": "NOT_VERIFIED",
  "canonical_write": false,
  "dispatch": false,
  "source_pit_admission": false,
  "A2_Technical_eligible": false,
  "A3_input_eligible": false,
  "next_gate": "A0 authenticated identity/source evidence and coverage planner; existing writer, numeric budget/date/account/rights/Drive scope must be independently verified before any later actual capture",
  "not_implemented": ["live news or DART ingestion", "authenticated V1/V2 or identity admission", "A0 queue connection", "OHLCV interval planning", "automatic provider capture", "scheduler activation", "investment mutation"]
}
